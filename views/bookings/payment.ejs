<% layout("/layouts/boilerplate") %>

<div class="row mt-4">
  <div class="col-lg-6 offset-lg-3">
    <div class="card shadow-sm p-4">
      <h3 class="mb-3">Confirm & Pay</h3>

      <!-- LISTING INFO -->
      <h5 class="fw-semibold"><%= booking.listing.title %></h5>

      <p class="text-muted">
        📍 <%= booking.listing.location %>, <%= booking.listing.country %>
      </p>

      <hr />

      <!-- BOOKING DETAILS -->
      <p>
        <strong>Check-in:</strong>
        <%= booking.checkIn.toDateString() %>
      </p>

      <p>
        <strong>Check-out:</strong>
        <%= booking.checkOut.toDateString() %>
      </p>

      <p>
        <strong>Guests:</strong>
        <%= booking.guests %>
      </p>

      <hr />

      <!-- PRICE -->
      <h4 class="fw-bold">Total: ₹ <%= booking.totalPrice %></h4>

      <!-- PAYMENT BUTTON (Stripe later) -->
      <button class="btn btn-danger w-100 mt-3" disabled>Pay Now</button>

      <p class="text-center text-muted mt-2 mb-0">
        Payment integration will be added next
      </p>
    </div>
  </div>
</div>
