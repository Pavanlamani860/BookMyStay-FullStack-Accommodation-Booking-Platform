<% layout("layouts/boilerplate") %>

<div class="container mt-5 mb-5">
  <div class="row justify-content-center">
    <div class="col-md-7 col-lg-5">
      <h2 class="text-center mb-4">My Profile</h2>

      <div class="card shadow-sm border-0 rounded-4">
        <div class="card-body p-5">
          <!-- Profile Icon -->
          <div
            class="rounded-circle bg-light d-flex align-items-center justify-content-center mx-auto mb-3"
            style="width: 85px; height: 85px"
          >
            <i class="fa-solid fa-user fa-2x text-secondary"></i>
          </div>

          <!-- User Name -->
          <h4 class="text-center mb-1"><%= currUser.username %></h4>

          <p class="text-muted text-center mb-4"><%= currUser.email %></p>

          <hr />

          <!-- Account Details -->
          <div class="mt-4">
            <div class="mb-3">
              <small class="text-muted">Username</small>
              <div class="fw-semibold"><%= currUser.username %></div>
            </div>

            <div class="mb-4">
              <small class="text-muted">Email</small>
              <div class="fw-semibold"><%= currUser.email %></div>
            </div>
          </div>

          <!-- Account Actions -->
          <div class="d-grid gap-2">
            <a href="/profile/edit" class="btn btn-outline-dark">
              <i class="fa-solid fa-pen-to-square me-2"></i>
              Edit Profile
            </a>

            <a href="/profile/password" class="btn btn-outline-danger">
              <i class="fa-solid fa-lock me-2"></i>
              Change Password
            </a>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>
