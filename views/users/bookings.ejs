<% layout("layouts/boilerplate") %>

<div class="container mt-5">
  <div class="d-flex justify-content-between align-items-center mb-4">
    <h3 class="mb-0">My Bookings</h3>
    <a href="/listings" class="btn btn-outline-dark">
      Explore Listings
    </a>
  </div>

  <% if (bookings.length === 0) { %>

    <div class="text-center mt-5">
      <h5>You haven't made any bookings yet.</h5>
      <p class="text-muted">
        Explore listings and book your next stay.
      </p>

      <a href="/listings" class="btn btn-dark">
        Explore Listings
      </a>
    </div>

  <% } else { %>

    <div class="row g-4">
      <% bookings.forEach(booking => { %>

        <div class="col-12 col-md-6 col-lg-4">
          <div class="card h-100 shadow-sm border-0">

            <!-- Listing Image -->
            <% if (booking.listing.image && booking.listing.image.url) { %>

              <img
                src="<%= booking.listing.image.url %>"
                class="card-img-top"
                alt="<%= booking.listing.title %>"
                style="height: 220px; object-fit: cover;"
              />
            <% } %>

            <div class="card-body">
              <h5 class="card-title">
                <%= booking.listing.title %>
              </h5>

              <p class="text-muted mb-3">
                <i class="fa-solid fa-location-dot"></i>
                <%= booking.listing.location %>,
                <%= booking.listing.country %>
              </p>

              <hr>

              <p class="mb-2">
                <strong>Check-in:</strong>
                <%= booking.checkIn.toDateString() %>
              </p>

              <p class="mb-2">
                <strong>Check-out:</strong>
                <%= booking.checkOut.toDateString() %>
              </p>

              <p class="mb-2">
                <strong>Guests:</strong>
                <%= booking.guests %>
              </p>

              <p class="mb-3">
                <strong>Total:</strong>
                ₹<%= booking.totalPrice %>
              </p>

              <!-- Payment Status -->
              <% if (booking.paymentStatus === "paid") { %>

                <span class="badge bg-success">
                  Payment Paid
                </span>
              
              <% } else if (booking.paymentStatus === "pending") { %>
              
                <span class="badge bg-warning text-dark">
                  Payment Pending
                </span>
              
                <div class="mt-3">
                  <a
                    href="/bookings/<%= booking._id %>/payment"
                    class="btn btn-success btn-sm w-100"
                  >
                    Pay Now
                  </a>
                </div>
              
              <% } else { %>
              
                <span class="badge bg-danger">
                  Payment Failed
                </span>
              
                <div class="mt-3">
                  <a
                    href="/bookings/<%= booking._id %>/payment"
                    class="btn btn-outline-danger btn-sm w-100"
                  >
                    Try Payment Again
                  </a>
                </div>
              
              <% } %>

              <!-- Booking Status -->
              <% if (booking.status === "confirmed") { %>
                <span class="badge bg-primary ms-1">
                  Confirmed
                </span>

              <% } else if (booking.status === "cancelled") { %>
                <span class="badge bg-secondary ms-1">
                  Cancelled
                </span>

              <% } else { %>
                <span class="badge bg-warning text-dark ms-1">
                  Pending
                </span>

              <% } %>

            </div>

          </div>

        </div>

      <% }) %>

    </div>

  <% } %>

</div>