<% layout("/layouts/boilerplate") %>
<div class="listing-main">
<div class="row mt-1">
  <!-- image div -->
  <div class="card col-7 offset-1 listing-card">
    <h3>Listings details</h3>
    <img
      src="<%= list.image.url %>"
      class="card-img-top show-img"
      alt="listing image"
    />
  </div>
  <div class="card col-6 offset-1 listing-card">
    <div class="mb-3">
      <h3 class="fw-semibold mb-1">
        <%= list.title %>
      </h3>

      <p class="text-muted mb-1">
        <i class="fa-solid fa-location-dot me-1"></i>
        <%= list.location %>, <%= list.country %>
      </p>

      <% if (list.reviews.length > 0) { 
          const avgRating =
            (list.reviews.reduce((sum, r) => sum + r.rating, 0) /
              list.reviews.length).toFixed(1);
      %>
        <div class="mb-3">
          <span class="badge bg-light text-dark border">
            ⭐ <%= avgRating %>
          </span>
          <span class="text-muted ms-2">
            · <%= list.reviews.length %> reviews
          </span>
        </div>
      <% } else { %>
        <p class="text-muted mb-3">
          ⭐ No reviews yet
        </p>
      <% } %>
      <p class="fs-6">
        <%= list.description %>
      </p>
    </div>

  <div class="border-top pt-3 mb-4">
    <p class="mb-2">
      <span class="fw-semibold">Hosted by:</span>
      <i class="fa-regular fa-user"></i>
      <span class="text-muted"><%= list.owner.username %></span>
    </p>
    <p class="text-muted mb-0">
      Verified host on BookMyStay
    </p>
  </div>
  <!-- ================= SECTION 3: PROPERTY DETAILS ================= -->
<div class="border-top pt-3 mb-2">
  <p class="mb-2">
    <span class="fw-semibold">Property Type:</span>
    <span class="text-muted"><%= list.category %></span>
  </p>

  <!-- Amenities -->
  <p class="fw-semibold mb-2">Amenities</p>

  <div class="d-flex flex-wrap gap-2 mb-1">
    <% list.amenities.forEach(amenity => { %>
      <span class="badge bg-light text-dark border fw-normal">
        <%= amenity %>
      </span>
    <% }) %>
  </div>
  </div>  
</div>

<!-- ================= RIGHT COLUMN ================= -->
<div class="col-lg-4 offset-1">
  <div class="card booking-card shadow-sm">
    <div class="card-body">
      <form method="POST" action="/listings/<%= list._id %>/book">

        <div class="d-flex align-items-baseline mb-3">
          <h4 class="fw-semibold mb-0">
            ₹ <%= list.price %>
          </h4>
          <span class="text-muted ms-2">/ night</span>
        </div>
      
        <div class="border rounded mb-3">
          <div class="row g-0 text-center">
      
            <div class="col-6 border-end p-2">
              <small class="text-muted">CHECK-IN</small>
            <input
              type="date"
              name="checkIn"
              class="form-control"
              min="<%= new Date().toISOString().split('T')[0] %>"
              required
            />
            </div>
      
            <div class="col-6 p-2">
              <small class="text-muted">CHECK-OUT</small>
            <input
              type="date"
              name="checkOut"
              class="form-control"
              min="<%= new Date().toISOString().split('T')[0] %>"
              required
            />
            </div>
          </div>
        </div>
      
        <div class="mb-3">
          <label class="form-label fw-semibold">Guests</label>
          <select name="guests" class="form-select">  
            <option value="1">1 guest</option>
            <option value="2">2 guests</option>
            <option value="3">3 guests</option>
            <option value="4">4 guests</option>
          </select>
        </div>
      
        <button
          type="submit"
          class="btn btn-danger w-100 mb-2"
          style="border-radius: 20px;"
        >
          Reserve
        </button>
      </form>
      <p class="text-center text-muted mb-0">
        You won’t be charged yet
      </p>
    </div>
  </div>
</div>
<!-- ================================================= -->

  <div class="col-6 offset-1 mb-3">
    <a
      href="/listings/<%= list._id %>/edit"
      class="btn btn-danger btn-sm"
    >
      Edit Listing
    </a>
  </div>

  <form
    method="post"
    action="/listings/<%= list._id %>?_method=DELETE"
  >
    <button class="btn btn-outline-dark offset-1 ">
      Delete Listing
    </button>
  </form>
</div>
</div>

<!-- ================= LOCATION SECTION ================= -->

<div class="row mt-3">
  <div class="col-8 offset-1">
    <hr />
    <h4>Where you'll be</h4>

    <div
      id="map"
      style="height: 320px; border-radius: 10px !important";
    ></div>
  <div class="mt-3 d-flex align-items-center gap-2 flex-wrap">
    <a
      href="https://www.google.com/maps/search/?api=1&query=<%= encodeURIComponent(list.location + ', ' + list.country) %>"
      target="_blank"
      class="btn btn-outline-primary mt-3"
    >
      📍 View on Google Maps
    </a>
<!-- ================= SHARE LOCATION ================= -->
<div class="mt-3">

  <% 
    const mapLink =
      "https://www.google.com/maps/search/?api=1&query=" +
      encodeURIComponent(list.location + ", " + list.country);

    const shareText =
      encodeURIComponent(`Check out this stay on BookMyStay: ${list.title}`);
  %>

  <div class="d-flex gap-2 flex-wrap social-media-share">

    <!-- WhatsApp -->
    <a
      href="https://wa.me/?text=<%= shareText %>%20<%= mapLink %>"
      target="_blank"
      class="btn btn-success btn-sm"
    >
      <i class="fa-brands fa-whatsapp me-1"></i>
      WhatsApp
    </a>

    <!-- Twitter -->
    <a
      href="https://twitter.com/intent/tweet?text=<%= shareText %>&url=<%= mapLink %>"
      target="_blank"
      class="btn btn-dark btn-sm"
    >
      <i class="fa-brands fa-x-twitter me-1"></i>
      Twitter
    </a>

    <!-- Facebook -->
    <a
      href="https://www.facebook.com/sharer/sharer.php?u=<%= mapLink %>"
      target="_blank"
      class="btn btn-primary btn-sm"
    >
      <i class="fa-brands fa-facebook-f me-1"></i>
      Facebook
    </a>

  </div>
</div>
</div>
</div>
<!-- ================================================ -->


<!-- ================= REVIEWS SECTION ================= -->

<div class="col-8 offset-1">
  <hr />
  <% if (currUser) { %>
    <h4>Leave a Review</h4>

    <form method="post" action="/listings/<%= list._id %>/reviews">
      <div class="mb-2 mt-2">
        <label class="form-label">Rating</label>

        <fieldset class="starability-slot">
          <input type="radio" id="no-rate" class="input-no-rate" name="review[rating]" value="0" checked aria-label="No rating." />

          <input type="radio" id="rate1" name="review[rating]" value="1" />
          <label for="rate1">1 star.</label>

          <input type="radio" id="rate2" name="review[rating]" value="2" />
          <label for="rate2">2 stars.</label>

          <input type="radio" id="rate3" name="review[rating]" value="3" />
          <label for="rate3">3 stars.</label>

          <input type="radio" id="rate4" name="review[rating]" value="4" />
          <label for="rate4">4 stars.</label>

          <input type="radio" id="rate5" name="review[rating]" value="5" />
          <label for="rate5">5 stars.</label>

          <span class="starability-focus-ring"></span>
        </fieldset>
      </div>

      <div class="mb-3  col-10">
        <label class="form-label">Comment</label>
        <textarea
          name="review[comment]"
          rows="5"
          class="form-control"
          required
        ></textarea>
      </div>

      <button class="btn btn-outline-dark mb-2">
        Submit
      </button>
    </form>
  <% } %>

  <hr />

  <p><b>All Reviews</b></p>
  <div class="row">
    <% for (let review of list.reviews) { %>
      <div class="card col-5 mb-3 ms-2">
        <div class="card-body">
          <h5>@<%= review.author.username %></h5>

          <p><%= review.comment %></p>

          <p
            class="starability-result"
            data-rating="<%= review.rating %>"
          >
          </p>

          <form
            method="post"
            action="/listings/<%= list._id %>/reviews/<%= review._id %>?_method=DELETE"
          >
            <button class="btn btn-outline-dark mb-2">
              Delete
            </button>
          </form>
        </div>
      </div>
    <% } %>
  </div>
</div>

<!-- ================= MAP SCRIPT ================= -->

<script>
  const mapDiv = document.getElementById("map");

  if (mapDiv) {
    const geometry = <%- JSON.stringify(list.geometry || null) %>;

    let coords;
    if (geometry && geometry.coordinates && geometry.coordinates.length === 2) {
      coords = [geometry.coordinates[1], geometry.coordinates[0]]; // lat, lng
    } else {
      coords = [20.5937, 78.9629]; // India fallback
    }

    const map = L.map(mapDiv).setView(coords, 6);

    L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png", {
      attribution: "© OpenStreetMap contributors",
    }).addTo(map);

    L.marker(coords)
      .addTo(map)
      .bindPopup("<%= list.location %>");

    // 🚨 THIS IS THE KEY LINE
    setTimeout(() => {
      map.invalidateSize();
    }, 300);
  }
</script>
